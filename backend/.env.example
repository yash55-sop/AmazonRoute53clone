APP_ENV=development
DATABASE_URL=sqlite:///./data/route53.db
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=route53_session
SESSION_LIFETIME_SECONDS=86400
# Production: use APP_ENV=production, HTTPS origins, SESSION_COOKIE_SECURE=true,
# and a DATABASE_URL located on persistent storage.
